{
  "name": "honors-inventory-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev-frontend": "npm run start --workspace=frontend",
    "dev-backend": "npm run start --workspace=backend",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
